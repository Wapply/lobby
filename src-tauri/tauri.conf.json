{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lobby",
  "version": "0.1.0",
  "identifier": "dev.lobby.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../src-tauri/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lobby",
        "width": 1100,
        "height": 700,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
